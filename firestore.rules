rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        // Ruler has full update control over RoomState (including seats & gameStarted)
        resource.data.seats.rulerUid == request.auth.uid ||
        // Authenticated players may update participants (Join/Leave), teams (Lock Turn), diceBroadcast, and logs
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'teams', 'diceBroadcast', 'logs']) ||
        // Allow a seated Master to clear ONLY their own seat when leaving the lobby
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'seats']) &&
          request.resource.data.seats.rulerUid == resource.data.seats.rulerUid &&
          (
            (resource.data.seats.masterAUid == request.auth.uid &&
              request.resource.data.seats.masterAUid == null &&
              request.resource.data.seats.masterBUid == resource.data.seats.masterBUid) ||
            (resource.data.seats.masterBUid == request.auth.uid &&
              request.resource.data.seats.masterBUid == null &&
              request.resource.data.seats.masterAUid == resource.data.seats.masterAUid)
          )
        )
      );

      match /chat/public {
        allow read, write: if request.auth != null;
      }

      match /secrets/master_a {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/rooms/$(roomId)).data.seats.rulerUid == request.auth.uid ||
          get(/databases/$(database)/documents/rooms/$(roomId)).data.seats.masterAUid == request.auth.uid
        );
      }

      match /secrets/master_b {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/rooms/$(roomId)).data.seats.rulerUid == request.auth.uid ||
          get(/databases/$(database)/documents/rooms/$(roomId)).data.seats.masterBUid == request.auth.uid
        );
      }

      match /secrets/ruler {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/rooms/$(roomId)).data.seats.rulerUid == request.auth.uid;
      }
    }
  }
}
